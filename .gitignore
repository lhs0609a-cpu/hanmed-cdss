# 공공데이터 활용가이드 문서 — 참고용, 레포에 넣지 않는다.
#
# 이 폴더는 Vercel 의 서버리스 함수 자리이기도 하다. 굽지 않은 공개 쪽을
# 요청 때 만드는 함수가 여기 있어야 하므로, 문서(.docx/.doc)만 막고
# 코드는 통과시킨다.
/api/*
!/api/*.mjs

# vite 가 설정을 번들할 때 남기는 임시 파일 — 윈도우에서 가끔 안 지워진다
vite.config.*.timestamp-*.mjs

# KCI 하베스트 진행 커서 — 실행 중 갱신되는 런타임 상태다. 저장소에 있으면
# 다른 기계에서 받을 때 남의 진행 지점부터 시작한다.
apps/api/src/database/seeds/.kci-resume-token

# DB 백업 — 환자 정보가 들어 있다. 저장소에 올리지 않는다.
apps/api/backups/
