{
  "name": "ongojishin-desktop",
  "version": "1.0.0",
  "description": "온고지신 AI - 한의학 CDSS 데스크톱 앱",
  "main": "out/main/index.js",
  "author": {
    "name": "온고지신",
    "email": "lhs0609c@naver.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:all": "electron-vite build && electron-builder --win --mac",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "release:mac": "electron-vite build && electron-builder --mac --publish always"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^20.11.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-updater": "^6.1.7",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "build": {
    "appId": "kr.co.ongojisin.desktop",
    "productName": "온고지신 AI",
    "copyright": "Copyright © 2026 온고지신",
    "electronVersion": "28.3.3",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lhs0609a-cpu",
        "repo": "hanmed-cdss",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "OngojisinAI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "온고지신 AI",
      "artifactName": "OngojisinAI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OngojisinAI-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.medical",
      "artifactName": "OngojisinAI-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "온고지신 AI ${version}",
      "artifactName": "OngojisinAI-${version}-${arch}.${ext}"
    }
  }
}
